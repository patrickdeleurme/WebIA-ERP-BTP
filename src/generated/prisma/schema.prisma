generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Rôles utilisateurs
enum Role {
  ADMIN
  RECEPTION
  MENAGE
  MAINTENANCE
  COMPTA
  BAR
}

model User {
  id       String             @id @default(uuid())
  email    String             @unique
  password String
  name     String
  role     Role               @default(RECEPTION)
  tasks    HousekeepingTask[]
}

// Paramètres fiscaux et de l'hôtel
model Settings {
  id              Int      @id @default(1)
  vatRate         Float    @default(0.20)
  touristTax      Float    @default(0.0)
  exchangeRateEUR Float
  exchangeRateUSD Float
  updatedAt       DateTime @updatedAt
}

// Chambres
enum RoomStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
  CLEANING
}

model Room {
  id           String              @id @default(uuid())
  number       String              @unique
  name         String?
  type         String
  capacity     Int
  basePriceMGA Float
  status       RoomStatus          @default(AVAILABLE)
  reservations Reservation[]
  maintenance  MaintenanceTicket[]
  housekeeping HousekeepingTask[]
}

// Clients
model Guest {
  id           String        @id @default(uuid())
  firstName    String
  lastName     String
  email        String?
  phone        String?
  country      String?
  guestType    String
  reservations Reservation[]
}

// Réservations et OTA
enum ReservationSource {
  DIRECT
  OTA
}

enum ReservationStatus {
  PLANNED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Reservation {
  id            String            @id @default(uuid())
  guestId       String
  guest         Guest             @relation(fields: [guestId], references: [id])
  roomId        String
  room          Room              @relation(fields: [roomId], references: [id])
  checkIn       DateTime
  checkOut      DateTime
  guestsCount   Int
  source        ReservationSource
  status        ReservationStatus
  otaPlatformId String?
  otaPlatform   OtaPlatform?      @relation(fields: [otaPlatformId], references: [id])
  invoice       Invoice?
  otaCommission OtaCommission?
}

// OTA & Commissions
model OtaPlatform {
  id             String        @id @default(uuid())
  name           String
  commissionType String
  commissionRate Float
  reservations   Reservation[]
}

model OtaCommission {
  id            String      @id @default(uuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  amountMGA     Float
  status        String
}

// Facturation
model Invoice {
  id            String      @id @default(uuid())
  reference     String      @unique
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id])
  amountHT_MGA  Float
  vatAmount_MGA Float
  touristTaxMGA Float
  totalTTC_MGA  Float
  status        String
}

// Tâches
model HousekeepingTask {
  id     String   @id @default(uuid())
  roomId String
  room   Room     @relation(fields: [roomId], references: [id])
  date   DateTime
  status String
  userId String?
  user   User?    @relation(fields: [userId], references: [id])
}

model MaintenanceTicket {
  id          String   @id @default(uuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  description String
  priority    String
  status      String
  createdAt   DateTime @default(now())
}
